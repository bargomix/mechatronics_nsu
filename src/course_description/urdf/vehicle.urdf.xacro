<?xml version="1.0"?>
<robot name="course_ackermann" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="wheelbase" default="0.80"/>
  <xacro:arg name="track" default="0.62"/>
  <xacro:arg name="wheel_radius" default="0.12"/>
  <xacro:property name="wheelbase" value="$(arg wheelbase)"/>
  <xacro:property name="track" value="$(arg track)"/>
  <xacro:property name="radius" value="$(arg wheel_radius)"/>
  <xacro:property name="wheel_width" value="0.07"/>
  <xacro:property name="body_size" value="1.05 0.52 0.22"/>
  <xacro:property name="sensor_xyz" value="0.28 0 0.38"/>

  <material name="body"><color rgba="0.05 0.36 0.72 1"/></material>
  <material name="tire"><color rgba="0.1 0.1 0.12 1"/></material>
  <material name="camera"><color rgba="0.95 0.72 0.18 1"/></material>
  <material name="lidar"><color rgba="0.9 0.16 0.12 1"/></material>
  <material name="imu"><color rgba="0.16 0.65 0.42 1"/></material>

  <link name="base_link">
    <inertial>
      <mass value="12.0"/>
      <inertia ixx="0.55" iyy="1.10" izz="1.40" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.12"/>
      <geometry><box size="${body_size}"/></geometry>
      <material name="body"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.12"/>
      <geometry><box size="${body_size}"/></geometry>
    </collision>
  </link>

  <xacro:macro name="wheel" params="name parent xyz">
    <link name="${name}_wheel">
      <inertial>
        <mass value="0.8"/>
        <inertia ixx="0.006" iyy="0.003" izz="0.006" ixy="0" ixz="0" iyz="0"/>
      </inertial>
      <visual>
        <origin rpy="${pi / 2} 0 0"/>
        <geometry><cylinder radius="${radius}" length="${wheel_width}"/></geometry>
        <material name="tire"/>
      </visual>
      <collision>
        <origin rpy="${pi / 2} 0 0"/>
        <geometry><cylinder radius="${radius}" length="${wheel_width}"/></geometry>
      </collision>
    </link>
    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="${parent}"/>
      <child link="${name}_wheel"/>
      <origin xyz="${xyz}"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="axle_side" params="side y">
    <link name="front_${side}_knuckle">
      <inertial>
        <mass value="0.2"/>
        <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>
    <joint name="front_${side}_steering_joint" type="revolute">
      <parent link="base_link"/>
      <child link="front_${side}_knuckle"/>
      <origin xyz="${wheelbase / 2} ${y} 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-0.55" upper="0.55" effort="25" velocity="1"/>
    </joint>
    <xacro:wheel name="front_${side}" parent="front_${side}_knuckle" xyz="0 0 0"/>
    <xacro:wheel name="rear_${side}" parent="base_link" xyz="${-wheelbase / 2} ${y} 0"/>
  </xacro:macro>

  <xacro:axle_side side="left" y="${track / 2}"/>
  <xacro:axle_side side="right" y="${-track / 2}"/>

  <xacro:macro name="sensor" params="name parent offset *geometry">
    <link name="${name}_link">
      <inertial>
        <mass value="0.033333333333"/>
        <inertia ixx="0.000333333333" iyy="0.000333333333" izz="0.000333333333"
                 ixy="0" ixz="0" iyz="0"/>
      </inertial>
      <visual>
        <origin xyz="${offset}"/>
        <xacro:insert_block name="geometry"/>
        <material name="${name}"/>
      </visual>
      <collision>
        <origin xyz="${offset}"/>
        <xacro:insert_block name="geometry"/>
      </collision>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${name}_link"/>
      <origin xyz="${sensor_xyz}"/>
    </joint>
  </xacro:macro>

  <!-- The SDF sensor frames coincide. Only the housings are offset. -->
  <xacro:sensor name="camera" parent="base_link" offset="0.06 0 0">
    <geometry><box size="0.08 0.08 0.05"/></geometry>
  </xacro:sensor>
  <xacro:sensor name="lidar" parent="base_link" offset="0 0 0.05">
    <geometry><cylinder radius="0.045" length="0.05"/></geometry>
  </xacro:sensor>
  <xacro:sensor name="imu" parent="base_link" offset="-0.055 0 0">
    <geometry><box size="0.06 0.06 0.04"/></geometry>
  </xacro:sensor>
</robot>
